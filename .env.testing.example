# Local integration-test configuration — safe placeholders only.
#
# Copy this file to `.env.testing` (git-ignored). `tests/bootstrap.php` loads
# it automatically, so `composer test:integration` works without typing DB_*
# variables. Only APP_ENV and DB_* are required; the integration suite builds
# its own admin/image configuration.
#
# The integration suite is destructive: it creates and drops the domain schema.
# It refuses to run unless APP_ENV=testing and DB_NAME ends with `_test`.
# Never point it at the development database (`spezitest`) or production.

APP_ENV=testing
APP_DEBUG=false

# Disposable local MariaDB 10.11 database, separate from `spezitest`
# (development) and from the production Plesk database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spezitest_test
DB_USER=spezitest_test
DB_PASSWORD=replace_with_local_test_password
DB_CHARSET=utf8mb4

# Optional — only if you also run the app manually against the test database.
# Set BOTH together (an admin username without a hash stops app construction):
#   php -r "echo password_hash('test-password', PASSWORD_DEFAULT), PHP_EOL;"
# ADMIN_USERNAME=test-admin
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_NAME=SPEZITEST_TEST
# ADMIN_IMAGE_STORAGE_ROOT=var/test-admin-images
