# Spezitest — Apache configuration for the public document root.
# `public/` must be the site document root; nothing above it is web-served.

Options -Indexes -MultiViews
DirectoryIndex index.php

# Front-controller routing: send anything that is not a real file or directory
# to the Slim application. QSA keeps the query string; L stops rewriting.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve dotfiles (defence in depth; real secrets live outside public/).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"

    # The site is HTTPS-only (Plesk performs the HTTP->HTTPS 301). Tell browsers
    # to never try plain HTTP again. Add "; preload" and submit to
    # hstspreload.org only once you are certain every subdomain is HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The site uses none of these browser features; deny them all.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"

    # Static assets carry no referrer beyond the origin.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Fingerprint-free static assets. The stylesheet and script names are stable
    # but query-string versioned (?v=), so a week is safe; the brand images and
    # icons effectively never change.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpe?g|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
