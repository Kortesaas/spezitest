# Safe local-development examples only. Never place real credentials here.
APP_ENV=local
APP_DEBUG=false

# Generate the hash locally with password_hash(); leave both values unset until configured.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_NAME=SPEZITEST_ADMIN
ADMIN_IMAGE_STORAGE_ROOT=var/admin-images
ADMIN_IMAGE_MAX_BYTES=5242880

# Development database. Integration tests use a separate `spezitest_test`
# database configured in `.env.testing` (see `.env.testing.example`).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spezitest
DB_USER=spezitest
DB_PASSWORD=replace_with_local_password
DB_CHARSET=utf8mb4

# Local legacy-import output only; keep outside public/.
LEGACY_IMAGE_STORAGE_ROOT=var/legacy-images
