# Safe local-development examples only. Never place real credentials here.
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_local_database_name
DB_USER=replace_with_local_database_user
DB_PASSWORD=replace_with_local_database_password

# Generate a unique secret for each deployed environment. Do not reuse this text.
APP_SECRET=replace_with_a_generated_secret
