# Spezitest production environment — TEMPLATE ONLY.
#
# Copy to `.env` in the DEPLOYED APPLICATION ROOT (the directory that CONTAINS
# `public/`), NOT inside `public/`. Fill in the real values from Plesk. Never
# commit a populated copy. Keep file permissions at 600 (owner read/write only).
#
# When your hosting reliably injects PHP-FPM environment variables you may set
# these as Plesk "Additional environment variables" instead of a file; the app
# reads real environment variables too. A `.env` file is the recommended,
# portable option on Plesk shared hosting.

# --- Application ---------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# --- Database (from Plesk > Databases) ---------------------------------
# The production endpoint is localhost:3306, but always configure it here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=REPLACE_with_plesk_database_name
DB_USER=REPLACE_with_plesk_database_user
DB_PASSWORD=REPLACE_with_a_strong_generated_password
DB_CHARSET=utf8mb4

# --- Admin login ------------------------------------------------------
# Generate the hash on any PHP 8.3 machine, then paste it here IN SINGLE
# QUOTES (a bcrypt hash contains $ characters that would otherwise be
# interpolated):
#   php -r "echo password_hash('YOUR-ADMIN-PASSWORD', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_USERNAME=REPLACE_with_admin_login_name
ADMIN_PASSWORD_HASH='REPLACE_with_password_hash_output'
ADMIN_SESSION_NAME=SPEZITEST_ADMIN

# --- Private image storage (MUST resolve outside public/) --------------
# Relative paths resolve against the application root. Point these at a
# writable directory that survives releases, e.g. a shared "var/" outside the
# release directory. Both must stay outside the web document root.
ADMIN_IMAGE_STORAGE_ROOT=var/admin-images
ADMIN_IMAGE_MAX_BYTES=8388608

# Legacy import images (only needed if the historical catalogue was imported).
# The imported files live under <this root>/legacy/<run-id>/...
LEGACY_IMAGE_STORAGE_ROOT=var/legacy-images
